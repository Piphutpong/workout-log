{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["gas/**/*.ts", "scripts/**/*.ts", "src/lib/**/*.ts", "src/types/**/*.ts", "src/features/nutrition/nutritionCalc.ts"]
}
